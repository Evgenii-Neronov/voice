# Downloaded model weights and caches stay here; see docs/MODELS.md.
models/
.cache/
.venvs/
vendor/
work/
__pycache__/
*.pyc
# Full runs are local; selected small WAVs and JSON manifests are tracked.
results/raw/
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
.env
*.gguf
results/music/*/full.wav
results/productions/*/full.wav

# New duet raw takes: final mastered MP3s are tracked under productions.
results/music/duet-*/full.mp3
results/music/duet-*/preview.wav

# Editable sessions: full-resolution WAV stems stay local.
results/editable/**/*.wav
results/music/editable-*/full.mp3
results/music/editable-*/preview.wav
