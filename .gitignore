# Downloaded model weights and caches stay here; see docs/MODELS.md.
models/
.cache/
.venvs/
vendor/
work/
__pycache__/
*.pyc
# Full runs are local; selected small WAVs and JSON manifests are tracked.
results/raw/
*.safetensors
*.ckpt
*.pth
*.pt
*.bin
.env
*.gguf
results/music/*/full.wav
results/productions/*/full.wav

# New duet raw takes: final mastered MP3s are tracked under productions.
results/music/duet-*/full.mp3
results/music/duet-*/preview.wav

# Editable sessions: full-resolution WAV stems stay local.
results/editable/**/*.wav
results/music/editable-*/full.mp3
results/music/editable-*/preview.wav

# New MiniMax hook takes: keep final MP3, omit duplicate raw exports.
results/music/minimax-hook-*/full.mp3
results/music/minimax-hook-*/preview.wav

# Three MiniMax arrangements: retain final deliveries, omit duplicate raw exports.
results/music/minimax-trio-*/full.mp3
results/music/minimax-trio-*/preview.wav

# Rap 2: keep the final production MP3; raw WAV and duplicate previews stay local.
results/music/minimax-rap2-*/full.mp3
results/music/minimax-rap2-*/preview.wav
# Superseded rap-2 drill take is retained locally; only audit metadata is tracked.
results/productions/minimax-rap2-drill-01/*.mp3

# Rap 3 raw duplicates stay local; final MP3 and audit metadata are tracked.
results/music/minimax-rap3-*/full.mp3
results/music/minimax-rap3-*/preview.wav
